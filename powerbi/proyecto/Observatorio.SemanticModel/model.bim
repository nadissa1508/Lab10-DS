{
  "name": "Observatorio",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "es-GT",
    "sourceQueryCulture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "RutaDatos",
        "kind": "m",
        "expression": "\"C:\\Users\\ninan\\OneDrive\\Documentos\\Escritorio\\UVG\\VIII SEMESTRE\\Data Science\\Lab10-DS\\powerbi\\datos\\\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "name": "dim_fecha",
        "columns": [
          {
            "name": "fecha",
            "dataType": "dateTime",
            "sourceColumn": "fecha",
            "summarizeBy": "none",
            "formatString": "yyyy-MM",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "anio",
            "dataType": "int64",
            "sourceColumn": "anio",
            "summarizeBy": "none"
          },
          {
            "name": "trimestre_num",
            "dataType": "int64",
            "sourceColumn": "trimestre_num",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "trimestre",
            "dataType": "string",
            "sourceColumn": "trimestre",
            "summarizeBy": "none",
            "sortByColumn": "trimestre_num"
          },
          {
            "name": "mes_num",
            "dataType": "int64",
            "sourceColumn": "mes_num",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "mes",
            "dataType": "string",
            "sourceColumn": "mes",
            "summarizeBy": "none",
            "sortByColumn": "mes_num"
          },
          {
            "name": "mes_anio",
            "dataType": "string",
            "sourceColumn": "mes_anio",
            "summarizeBy": "none",
            "sortByColumn": "fecha"
          },
          {
            "name": "conjunto",
            "dataType": "string",
            "sourceColumn": "conjunto",
            "summarizeBy": "none"
          },
          {
            "name": "pandemia",
            "dataType": "string",
            "sourceColumn": "pandemia",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_fecha",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Csv.Document(File.Contents(RutaDatos & \"dim_fecha.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"fecha\", type date}, {\"anio\", Int64.Type}, {\"trimestre_num\", Int64.Type}, {\"trimestre\", type text}, {\"mes_num\", Int64.Type}, {\"mes\", type text}, {\"mes_anio\", type text}, {\"conjunto\", type text}, {\"pandemia\", type text}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Periodo",
            "levels": [
              {
                "name": "anio",
                "ordinal": 0,
                "column": "anio"
              },
              {
                "name": "trimestre",
                "ordinal": 1,
                "column": "trimestre"
              },
              {
                "name": "mes",
                "ordinal": 2,
                "column": "mes"
              }
            ]
          }
        ]
      },
      {
        "name": "dim_modelo",
