                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"serie_id\", type text}, {\"config\", type text}, {\"epoca\", Int64.Type}, {\"perdida_ajuste\", type number}, {\"perdida_validacion\", type number}, {\"mejor_epoca\", Int64.Type}}, \"en-US\")",
                "in",
                "    Tipos"
              ],
              "type": "m"
            }
          }
        ]
      },
