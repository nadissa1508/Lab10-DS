      {
        "name": "Medidas",
        "columns": [
          {
            "name": "Id",
            "dataType": "int64",
            "isHidden": true,
            "lineageTag": "6b040156-1e9a-4ab5-990b-9041ef183223",
            "sourceColumn": "Id",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "70da2d55-35b1-45d3-bf4a-bd5345aafe7b",
        "measures": [
          {
            "name": "Viajeros",
            "displayFolder": "Indicadores",
            "expression": [
              "VAR SerieActiva =",
              "    IF (",
              "        ISEMPTY ( VALUES ( dim_serie[serie_id] ) ),",
              "        BLANK (),",
              "        SELECTEDVALUE ( dim_serie[serie_id], \"total\" )",
              "    )",
              "RETURN",
              "    CALCULATE (",
              "        SUM ( hechos_viajeros[viajeros] ),",
              "        REMOVEFILTERS ( dim_serie ),",
              "        dim_serie[serie_id] = SerieActiva",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "3b8ce6de-5534-44b4-aa9f-437491bc33fb"
          },
          {
            "name": "Viajeros total nacional",
            "displayFolder": "Indicadores",
            "expression": [
              "CALCULATE (",
              "    SUM ( hechos_viajeros[viajeros] ),",
              "    REMOVEFILTERS ( dim_serie ),",
              "    dim_serie[serie_id] = \"total\"",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "d4152005-cf7c-4691-a19e-45c694a99563"
          },
          {
            "name": "Participación",
            "displayFolder": "Indicadores",
            "expression": "DIVIDE ( [Viajeros], [Viajeros total nacional] )",
            "formatString": "0.0%",
            "lineageTag": "4fd48901-3898-41b0-b822-cee90192b0ed"
          },
          {
            "name": "Promedio mensual",
            "displayFolder": "Indicadores",
            "expression": "DIVIDE ( [Viajeros], COUNTROWS ( VALUES ( dim_fecha[fecha] ) ) )",
            "formatString": "#,0",
            "lineageTag": "e06c1c9c-b807-48d4-aa64-16c990a2b45c"
          },
          {
            "name": "Mes más alto (valor)",
            "displayFolder": "Indicadores",
            "expression": "MAXX ( VALUES ( dim_fecha[fecha] ), [Viajeros] )",
            "formatString": "#,0",
            "lineageTag": "13ab5341-977f-4718-a05d-94fde1cc003f"
          },
          {
            "name": "Mes más alto (mes)",
            "displayFolder": "Indicadores",
            "expression": "MAXX ( TOPN ( 1, VALUES ( dim_fecha[mes_anio] ), [Viajeros], DESC ), dim_fecha[mes_anio] )",
            "lineageTag": "529d5772-02e4-4d52-aa5b-df911713d97f"
          },
          {
            "name": "Mes más bajo (valor)",
            "displayFolder": "Indicadores",
            "expression": "MINX ( VALUES ( dim_fecha[fecha] ), [Viajeros] )",
            "formatString": "#,0",
            "lineageTag": "1bfb3f5b-8334-4b9d-aa10-2aa5f7ac46c9"
          },
          {
            "name": "Mes más bajo (mes)",
            "displayFolder": "Indicadores",
            "expression": "MAXX ( TOPN ( 1, VALUES ( dim_fecha[mes_anio] ), [Viajeros], ASC ), dim_fecha[mes_anio] )",
            "lineageTag": "7579683a-9117-4b89-aa41-865471b17d9c"
          },
          {
            "name": "Título V1",
            "displayFolder": "Indicadores",
            "expression": "\"Evolución de los viajeros: \" & SELECTEDVALUE ( dim_serie[serie], \"Total nacional\" )",
            "lineageTag": "0730b345-ba56-4d46-87fb-231ca5b3de56"
          },
          {
            "name": "Aviso sin datos",
            "displayFolder": "Indicadores",
            "expression": [
              "IF (",
              "    ISBLANK ( [Viajeros] ),",
              "    \"No hay información para esta selección. Use Restablecer filtros.\",",
              "    \"\"",
              ")"
            ],
            "lineageTag": "7055e23d-401d-4900-8a8e-5d32a06b59bf"
          },
          {
            "name": "Pronóstico",
            "displayFolder": "Indicadores",
            "expression": [
              "VAR SerieActiva =",
              "    IF (",
              "        ISEMPTY ( VALUES ( dim_serie[serie_id] ) ),",
              "        BLANK (),",
              "        SELECTEDVALUE ( dim_serie[serie_id], \"total\" )",
              "    )",
              "RETURN",
              "    IF (",
              "        HASONEVALUE ( dim_modelo[modelo_id] ),",
              "        CALCULATE (",
              "            SUM ( hechos_pronosticos[predicho] ),",
              "            REMOVEFILTERS ( dim_serie ),",
              "            dim_serie[serie_id] = SerieActiva",
              "        )",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "af77a285-c90d-4c32-be36-b7a05de7762e"
          },
          {
            "name": "MAE",
            "displayFolder": "Indicadores",
            "expression": [
              "VAR SerieActiva =",
              "    IF (",
              "        ISEMPTY ( VALUES ( dim_serie[serie_id] ) ),",
              "        BLANK (),",
              "        SELECTEDVALUE ( dim_serie[serie_id], \"total\" )",
              "    )",
              "RETURN",
              "    IF (",
              "        HASONEVALUE ( dim_modelo[modelo_id] ),",
              "        CALCULATE (",
              "            MIN ( metricas_modelos[MAE] ),",
              "            REMOVEFILTERS ( dim_serie ),",
              "            dim_serie[serie_id] = SerieActiva",
              "        )",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "603247c9-fb01-4f50-94b0-6131485cda12"
          },
          {
            "name": "RMSE",
            "displayFolder": "Indicadores",
            "expression": [
              "VAR SerieActiva =",
              "    IF (",
              "        ISEMPTY ( VALUES ( dim_serie[serie_id] ) ),",
              "        BLANK (),",
              "        SELECTEDVALUE ( dim_serie[serie_id], \"total\" )",
              "    )",
              "RETURN",
              "    IF (",
              "        HASONEVALUE ( dim_modelo[modelo_id] ),",
              "        CALCULATE (",
              "            MIN ( metricas_modelos[RMSE] ),",
              "            REMOVEFILTERS ( dim_serie ),",
              "            dim_serie[serie_id] = SerieActiva",
              "        )",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "6c506da5-d939-456b-bc42-226a6a990464"
          },
          {
            "name": "MAE como % del mes promedio",
            "displayFolder": "Indicadores",
            "expression": [
              "VAR SerieActiva =",
              "    IF (",
              "        ISEMPTY ( VALUES ( dim_serie[serie_id] ) ),",
              "        BLANK (),",
              "        SELECTEDVALUE ( dim_serie[serie_id], \"total\" )",
              "    )",
              "RETURN",
              "    IF (",
              "        HASONEVALUE ( dim_modelo[modelo_id] ),",
              "        CALCULATE (",
              "            MIN ( metricas_modelos[MAE_pct_nivel] ),",
              "            REMOVEFILTERS ( dim_serie ),",
              "            dim_serie[serie_id] = SerieActiva",
              "        )",
              "    )"
            ],
            "formatString": "0.0%",
            "lineageTag": "67c0a2cb-233e-4957-b233-5627d0a26bff"
          },
          {
            "name": "Aviso modelo sin datos",
            "displayFolder": "Indicadores",
            "expression": [
              "IF (",
              "    HASONEVALUE ( dim_modelo[modelo_id] ) && ISBLANK ( [MAE] ),",
              "    \"Este modelo no está disponible para la serie elegida. LSTM solo existe para el Total nacional y América del Centro.\",",
              "    \"\"",
              ")"
            ],
            "lineageTag": "9cdd3ec0-6c6a-4630-9f72-5ce724ca188d"
          },
          {
            "name": "Viajeros mismos meses 2019",
            "displayFolder": "Indicadores",
            "expression": [
              "VAR Meses = VALUES ( dim_fecha[mes_num] )",
              "RETURN",
              "    CALCULATE (",
              "        [Viajeros],",
              "        REMOVEFILTERS ( dim_fecha ),",
              "        dim_fecha[anio] = 2019,",
              "        TREATAS ( Meses, dim_fecha[mes_num] )",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "e23faaca-cf8e-408d-885a-f121af478c68"
          },
          {
            "name": "Índice de recuperación",
            "displayFolder": "Indicadores",
            "expression": [
              "IF (",
              "    MIN ( dim_fecha[anio] ) >= 2019,",
              "    DIVIDE ( [Viajeros], [Viajeros mismos meses 2019] ) * 100",
              ")"
            ],
            "formatString": "0.0",
            "lineageTag": "ce46f89a-58d5-4ccb-b543-a28914c77600"
          },
          {
            "name": "Nivel 2019",
            "displayFolder": "Indicadores",
            "expression": "IF ( NOT ISBLANK ( [Índice de recuperación] ), 100 )",
            "formatString": "0.0",
            "lineageTag": "cc01256a-9208-47f7-9bd0-c9e6af2c2791"
          },
          {
            "name": "Límite inferior 80 %",
            "displayFolder": "Indicadores",
            "expression": [
              "VAR SerieActiva =",
              "    IF (",
              "        ISEMPTY ( VALUES ( dim_serie[serie_id] ) ),",
              "        BLANK (),",
              "        SELECTEDVALUE ( dim_serie[serie_id], \"total\" )",
              "    )",
              "RETURN",
              "    IF (",
              "        HASONEVALUE ( dim_modelo[modelo_id] ),",
              "        CALCULATE (",
              "            SUM ( hechos_pronosticos[li] ),",
              "            REMOVEFILTERS ( dim_serie ),",
              "            dim_serie[serie_id] = SerieActiva",
              "        )",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "145ed3ba-0da7-4e41-9b9a-9abd1274292a"
          },
          {
            "name": "Límite superior 80 %",
            "displayFolder": "Indicadores",
            "expression": [
              "VAR SerieActiva =",
              "    IF (",
              "        ISEMPTY ( VALUES ( dim_serie[serie_id] ) ),",
              "        BLANK (),",
              "        SELECTEDVALUE ( dim_serie[serie_id], \"total\" )",
              "    )",
              "RETURN",
              "    IF (",
              "        HASONEVALUE ( dim_modelo[modelo_id] ),",
              "        CALCULATE (",
              "            SUM ( hechos_pronosticos[ls] ),",
              "            REMOVEFILTERS ( dim_serie ),",
              "            dim_serie[serie_id] = SerieActiva",
              "        )",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "0c408b7e-0f20-472e-ba94-884f6380881d"
          },
          {
            "name": "Pérdida de ajuste",
            "displayFolder": "Indicadores",
            "expression": [
              "VAR SerieActiva =",
              "    IF (",
              "        ISEMPTY ( VALUES ( dim_serie[serie_id] ) ),",
              "        BLANK (),",
              "        SELECTEDVALUE ( dim_serie[serie_id], \"total\" )",
              "    )",
              "VAR Configuracion = SELECTEDVALUE ( perdidas_lstm[config], \"Modelo A (20 neuronas, 1 capa(s), dropout 0.0)\" )",
              "RETURN",
              "    CALCULATE (",
              "        AVERAGE ( perdidas_lstm[perdida_ajuste] ),",
              "        REMOVEFILTERS ( dim_serie ),",
              "        dim_serie[serie_id] = SerieActiva,",
              "        perdidas_lstm[config] = Configuracion",
              "    )"
            ],
            "formatString": "0.0000",
            "lineageTag": "fc54cd06-edcf-47b2-b5c1-6b8f0da55365"
          },
          {
            "name": "Pérdida de validación",
            "displayFolder": "Indicadores",
            "expression": [
              "VAR SerieActiva =",
              "    IF (",
              "        ISEMPTY ( VALUES ( dim_serie[serie_id] ) ),",
              "        BLANK (),",
              "        SELECTEDVALUE ( dim_serie[serie_id], \"total\" )",
              "    )",
              "VAR Configuracion = SELECTEDVALUE ( perdidas_lstm[config], \"Modelo A (20 neuronas, 1 capa(s), dropout 0.0)\" )",
              "RETURN",
              "    CALCULATE (",
              "        AVERAGE ( perdidas_lstm[perdida_validacion] ),",
              "        REMOVEFILTERS ( dim_serie ),",
              "        dim_serie[serie_id] = SerieActiva,",
              "        perdidas_lstm[config] = Configuracion",
              "    )"
            ],
            "formatString": "0.0000",
            "lineageTag": "160f6f75-7682-4e83-9eaf-76f1d35ca686"
          },
          {
            "name": "Aviso entrenamiento",
            "displayFolder": "Indicadores",
            "expression": [
              "IF (",
              "    ISBLANK ( [Pérdida de ajuste] ),",
              "    \"LSTM solo está disponible para el total nacional y América del Centro.\",",
              "    \"MSE estandarizado; no está expresado en viajeros. El filtro de fechas no cambia el entrenamiento.\"",
              ")"
            ],
            "lineageTag": "ea382019-e914-413a-98c4-a108e658a1b5"
          },
          {
            "name": "Selección activa",
            "displayFolder": "Indicadores",
            "expression": [
              "SELECTEDVALUE ( dim_serie[serie], \"Total nacional\" ) & \" | \" &",
              "FORMAT ( MIN ( dim_fecha[fecha] ), \"mmm yyyy\", \"es-GT\" ) & \" a \" &",
              "FORMAT ( MAX ( dim_fecha[fecha] ), \"mmm yyyy\", \"es-GT\" )"
            ],
            "lineageTag": "3274b972-73e2-421a-bd4d-c9bbe20b460f"
          }
        ],
        "partitions": [
          {
            "name": "Medidas",
            "mode": "import",
            "source": {
              "expression": "#table(type table [Id = Int64.Type], {{1}})",
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}