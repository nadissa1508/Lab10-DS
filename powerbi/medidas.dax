// Usa una sola serie; la selección inicial es el total nacional.


// Valores observados.

Viajeros =
VAR SerieActiva = SELECTEDVALUE ( dim_serie[serie_id], "total" )
RETURN
    CALCULATE (
        SUM ( hechos_viajeros[viajeros] ),
        REMOVEFILTERS ( dim_serie ),
        dim_serie[serie_id] = SerieActiva
    )
// Formato: número entero con separador de miles.

Viajeros total nacional =
CALCULATE (
    SUM ( hechos_viajeros[viajeros] ),
    REMOVEFILTERS ( dim_serie ),
    dim_serie[serie_id] = "total"
)
// Conserva el período seleccionado.

Participación =
DIVIDE ( [Viajeros], [Viajeros total nacional] )
// Formato: porcentaje con 1 decimal.

Promedio mensual =
DIVIDE ( [Viajeros], COUNTROWS ( VALUES ( dim_fecha[fecha] ) ) )
// Formato: número entero con separador de miles.

Mes más alto (valor) =
MAXX ( VALUES ( dim_fecha[fecha] ), [Viajeros] )

Mes más alto (mes) =
MAXX ( TOPN ( 1, VALUES ( dim_fecha[mes_anio] ), [Viajeros], DESC ), dim_fecha[mes_anio] )

Mes más bajo (valor) =
MINX ( VALUES ( dim_fecha[fecha] ), [Viajeros] )

Mes más bajo (mes) =
MAXX ( TOPN ( 1, VALUES ( dim_fecha[mes_anio] ), [Viajeros], ASC ), dim_fecha[mes_anio] )


// Identifica la selección.

Título V1 =
"Evolución de los viajeros: " & SELECTEDVALUE ( dim_serie[serie], "Total nacional" )

Aviso sin datos =
IF (
    ISBLANK ( [Viajeros] ),
    "No hay información para esta selección. Use Restablecer filtros.",
    ""
)


// Evalúa cada modelo sobre los 63 meses de prueba.

Pronóstico =
VAR SerieActiva = SELECTEDVALUE ( dim_serie[serie_id], "total" )
RETURN
    IF (
        HASONEVALUE ( dim_modelo[modelo_id] ),
        CALCULATE (
            SUM ( hechos_pronosticos[predicho] ),
            REMOVEFILTERS ( dim_serie ),
            dim_serie[serie_id] = SerieActiva
        )
    )
// Formato: número entero con separador de miles.

MAE =
VAR SerieActiva = SELECTEDVALUE ( dim_serie[serie_id], "total" )
RETURN
    IF (
        HASONEVALUE ( dim_modelo[modelo_id] ),
        CALCULATE (
            MIN ( metricas_modelos[MAE] ),
            REMOVEFILTERS ( dim_serie ),
            dim_serie[serie_id] = SerieActiva
        )
    )
// Existe una fila por serie y modelo.

RMSE =
VAR SerieActiva = SELECTEDVALUE ( dim_serie[serie_id], "total" )
RETURN
    IF (
        HASONEVALUE ( dim_modelo[modelo_id] ),
        CALCULATE (
            MIN ( metricas_modelos[RMSE] ),
            REMOVEFILTERS ( dim_serie ),
            dim_serie[serie_id] = SerieActiva
        )
    )

MAE como % del mes promedio =
VAR SerieActiva = SELECTEDVALUE ( dim_serie[serie_id], "total" )
RETURN
    IF (
        HASONEVALUE ( dim_modelo[modelo_id] ),
        CALCULATE (
            MIN ( metricas_modelos[MAE_pct_nivel] ),
            REMOVEFILTERS ( dim_serie ),
            dim_serie[serie_id] = SerieActiva
        )
    )
// Formato: porcentaje sin decimales.

Aviso modelo sin datos =
IF (
    HASONEVALUE ( dim_modelo[modelo_id] ) && ISBLANK ( [MAE] ),
    "Este modelo no está disponible para la serie elegida. LSTM solo existe para el Total nacional y América del Centro.",
    ""
)

// Compara únicamente los mismos meses de 2019.
Viajeros mismos meses 2019 =
VAR Meses = VALUES ( dim_fecha[mes_num] )
RETURN
    CALCULATE (
        [Viajeros],
        REMOVEFILTERS ( dim_fecha ),
        dim_fecha[anio] = 2019,
        TREATAS ( Meses, dim_fecha[mes_num] )
    )

Índice de recuperación =
IF (
    MIN ( dim_fecha[anio] ) >= 2019,
    DIVIDE ( [Viajeros], [Viajeros mismos meses 2019] ) * 100
)

Nivel 2019 =
IF ( NOT ISBLANK ( [Índice de recuperación] ), 100 )

Límite inferior 80 % =
VAR SerieActiva = SELECTEDVALUE ( dim_serie[serie_id], "total" )
RETURN
    IF (
        HASONEVALUE ( dim_modelo[modelo_id] ),
        CALCULATE (
            SUM ( hechos_pronosticos[li] ),
            REMOVEFILTERS ( dim_serie ),
            dim_serie[serie_id] = SerieActiva
        )
    )

Límite superior 80 % =
VAR SerieActiva = SELECTEDVALUE ( dim_serie[serie_id], "total" )
RETURN
    IF (
        HASONEVALUE ( dim_modelo[modelo_id] ),
        CALCULATE (
            SUM ( hechos_pronosticos[ls] ),
            REMOVEFILTERS ( dim_serie ),
            dim_serie[serie_id] = SerieActiva
        )
    )

Pérdida de ajuste =
VAR SerieActiva = SELECTEDVALUE ( dim_serie[serie_id], "total" )
VAR Configuracion = SELECTEDVALUE ( perdidas_lstm[config], "Modelo A (20 neuronas, 1 capa(s), dropout 0.0)" )
RETURN
    CALCULATE (
        AVERAGE ( perdidas_lstm[perdida_ajuste] ),
        REMOVEFILTERS ( dim_serie ),
        dim_serie[serie_id] = SerieActiva,
        perdidas_lstm[config] = Configuracion
    )

Pérdida de validación =
VAR SerieActiva = SELECTEDVALUE ( dim_serie[serie_id], "total" )
VAR Configuracion = SELECTEDVALUE ( perdidas_lstm[config], "Modelo A (20 neuronas, 1 capa(s), dropout 0.0)" )
RETURN
    CALCULATE (
        AVERAGE ( perdidas_lstm[perdida_validacion] ),
        REMOVEFILTERS ( dim_serie ),
        dim_serie[serie_id] = SerieActiva,
        perdidas_lstm[config] = Configuracion
    )

Aviso entrenamiento =
IF (
    ISBLANK ( [Pérdida de ajuste] ),
    "LSTM solo está disponible para el total nacional y América del Centro.",
    "MSE estandarizado; no está expresado en viajeros. El filtro de fechas no cambia el entrenamiento."
)

Selección activa =
SELECTEDVALUE ( dim_serie[serie], "Total nacional" ) & " | " &
FORMAT ( MIN ( dim_fecha[fecha] ), "mmm yyyy", "es-GT" ) & " a " &
FORMAT ( MAX ( dim_fecha[fecha] ), "mmm yyyy", "es-GT" )
